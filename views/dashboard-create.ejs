<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>List Your Business | Habeshatie</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen">
  <header class="bg-slate-900 border-b border-slate-800 px-6 py-4 flex justify-between items-center">
    <a href="/" class="text-xl font-bold tracking-tight text-white">Habesha<span class="text-amber-500">tie</span></a>
    <nav class="flex items-center gap-4 text-sm font-semibold">
      <a href="/" class="text-slate-300 hover:text-white">Explore</a>
      <a href="/dashboard" class="text-slate-300 hover:text-white">Dashboard</a>
      <a href="/logout" class="bg-red-600 hover:bg-red-500 text-white px-3 py-1.5 rounded-lg">Logout</a>
    </nav>
  </header>

  <main class="max-w-3xl mx-auto px-6 py-10">
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 shadow-2xl">
      <h1 class="text-2xl font-extrabold text-white mb-6">List Your Habesha Business</h1>

      <form action="/dashboard/create" method="POST" enctype="multipart/form-data" class="space-y-6">
        <div>
          <label class="block text-xs uppercase tracking-wider text-slate-400 font-semibold mb-2">Business Name</label>
          <input type="text" name="name" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-500" placeholder="e.g., Lalibela Restaurant">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs uppercase tracking-wider text-slate-400 font-semibold mb-2">Category</label>
            <select name="category" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-500">
              <option value="" disabled selected>Select Category</option>
              <option value="Restaurant & Catering">Restaurant & Catering</option>
              <option value="Café & Coffee Shop">Café & Coffee Shop</option>
              <option value="Retail & Grocery">Retail & Grocery (Spices, Injera, Teff)</option>
              <option value="Fashion & Traditional Wear">Fashion & Traditional Wear (Kemis, Netsela)</option>
              <option value="Beauty, Hair & Spa">Beauty, Hair & Spa</option>
              <option value="Professional Services">Professional Services (Legal, Tax, Translation)</option>
              <option value="Logistics & Cargo">Logistics & Cargo Shipping</option>
              <option value="Real Estate & Housing">Real Estate & Housing</option>
              <option value="Travel & Tourism">Travel & Tourism</option>
              <option value="Events & Music">Events & Music Production</option>
              <option value="Healthcare & Wellness">Healthcare & Wellness</option>
              <option value="Other">Other</option>
            </select>
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider text-slate-400 font-semibold mb-2">Country</label>
            <select name="country" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-500">
              <option value="" disabled selected>Select Country</option>
              <option value="United States">United States</option>
              <option value="United Kingdom">United Kingdom</option>
              <option value="Canada">Canada</option>
              <option value="Germany">Germany</option>
              <option value="Sweden">Sweden</option>
              <option value="Switzerland">Switzerland</option>
              <option value="Netherlands">Netherlands</option>
              <option value="Norway">Norway</option>
              <option value="France">France</option>
              <option value="Italy">Italy</option>
              <option value="United Arab Emirates">United Arab Emirates</option>
              <option value="Saudi Arabia">Saudi Arabia</option>
              <option value="Israel">Israel</option>
              <option value="Ethiopia">Ethiopia</option>
              <option value="Eritrea">Eritrea</option>
              <option value="Australia">Australia</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs uppercase tracking-wider text-slate-400 font-semibold mb-2">City</label>
          <input type="text" name="city" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-500" placeholder="e.g., London, Washington D.C., Frankfurt">
        </div>

        <div>
          <label class="block text-xs uppercase tracking-wider text-slate-400 font-semibold mb-2">WhatsApp / Phone Number (with Country Code)</label>
          <input type="text" name="phone" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-500" placeholder="e.g., +442079460000">
        </div>

        <div>
          <label class="block text-xs uppercase tracking-wider text-slate-400 font-semibold mb-2">Languages Spoken</label>
          <input type="text" name="languages" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-500" placeholder="e.g., Amharic, Tigrinya, English, German">
        </div>

        <div>
          <label class="block text-xs uppercase tracking-wider text-slate-400 font-semibold mb-2">Business Description</label>
          <textarea name="description" rows="4" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-amber-500" placeholder="Describe your services, products, and specialties..."></textarea>
        </div>

        <div>
          <label class="block text-xs uppercase tracking-wider text-slate-400 font-semibold mb-2">Business Cover Photo</label>
          <input type="file" name="photo" accept="image/*" class="w-full text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-semibold file:bg-amber-500 file:text-slate-950 hover:file:bg-amber-400 cursor-pointer">
        </div>

        <button type="submit" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-3.5 rounded-xl transition shadow-lg">Publish Business Listing</button>
      </form>
    </div>
  </main>
</body>
</html>
