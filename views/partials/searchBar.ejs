<div class="search-hero-box">
  <form id="searchForm" class="search-single-row">
    <!-- 1. Category Field -->
    <div class="input-wrapper search-what-wrapper">
      <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <select id="searchInput" name="q" class="search-select-field">
        <option value="">All Businesses & Services</option>
      </select>
    </div>

    <!-- 2. Location Field -->
    <div class="input-wrapper search-where-wrapper">
      <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
        <circle cx="12" cy="10" r="3"></circle>
      </svg>
      <input type="text" id="locationInput" name="where" class="search-input-field" placeholder="City or postcode" value="">
      <button type="button" id="locateBtn" class="locate-btn">GPS</button>
    </div>

    <!-- 3. Radius Dropdown Field -->
    <div class="input-wrapper search-radius-wrapper">
      <select id="radiusSelect" name="radius" class="search-select-field">
        <option value="5">Within 5 mi</option>
        <option value="10" selected>Within 10 mi</option>
        <option value="25">Within 25 mi</option>
        <option value="50">Within 50 mi</option>
      </select>
    </div>

    <!-- 4. Submit Button -->
    <button type="submit" class="btn-search" style="padding: 0.75rem 1.25rem; background: var(--primary, #0f172a); color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">Search</button>
  </form>
  <div id="searchResults" class="search-results-dropdown hidden"></div>
</div>
